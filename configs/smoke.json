{
  "name": "smoke",
  "description": "Quick installation check with a small grid and 3 validation and 3 test recordings. Not a scientific evaluation.",
  "output_dir": "results/smoke",
  "fs": 250,
  "seconds": 12,
  "warmup_seconds": 1.0,
  "eps": 1e-6,
  "development_seeds": {"start": 0, "count": 20},
  "validation": {
    "seeds": {"start": 100, "count": 3},
    "scale": 1.0
  },
  "grid": {
    "M": [3, 8],
    "lms_mu": [0.01, 0.05, 0.2],
    "nlms_mu": [0.05, 0.2, 1.0]
  },
  "test": {
    "seeds": {"start": 1000, "count": 3},
    "conditions": [
      {"name": "scale_0.3", "scale": 0.3},
      {"name": "scale_1.0", "scale": 1.0},
      {"name": "scale_3.0", "scale": 3.0},
      {"name": "pathway_change", "scale": 1.0, "pathway_after": [-0.2, 0.3, 0.1], "change_time": 6.0},
      {"name": "leakage", "scale": 1.0, "leakage": 0.2}
    ]
  },
  "timing": {"recordings": 2, "repeats": 3}
}